# ==========================================
# E-CELL UIET MDU Environment Variables
# Copy these into your Vercel Project Settings > Environment Variables
# ==========================================

# Supabase (Required for Authentication, Events, Startups & Profiles)
# Found in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Web3Forms (Optional: Used for public contact & inquiry form submissions)
# Default fallback is provided in settings if omitted
NEXT_PUBLIC_WEB3FORMS_KEY=your-web3forms-access-key

# EmailJS (Optional: Used for client notifications & direct mailings)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
